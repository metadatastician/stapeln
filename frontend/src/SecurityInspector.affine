             )}
           >
             {gradeDisplay(state.grade)->React.string}
           </div>
           <div style={Sx.make(~fontSize="16px", ~color="#8892a6", ())}>
             {"Security Grade"->React.string}
           </div>
         </div>
       </div>
   
       <div
