                 </strong>
               </span>
             | None => React.null
             }}
   
             {vuln.fixAvailable
               ? <button
                   onClick={e => {
                     ReactEvent.Mouse.stopPropagation(e)
                     dispatch(ApplyFix(vuln.id))
                   }}
                   style={Sx.make(
