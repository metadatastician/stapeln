// Main.affine - Application entry point for AffineScript frontend
//
// This file replaces the ReScript Main.res and serves as the entry point
// for the AffineScript-based frontend.

import ReactDOM from "react-dom/client"
import App from "./App.affine"

effect DOM {
  fn querySelector(selector: String) -> Option<HTMLElement>;
  
  struct HTMLElement {
    // Opaque type for HTML elements
  }
  
  struct ReactRoot {
    // Opaque type for React root
  }
  
  fn createRoot(element: HTMLElement) -> ReactRoot;
  
  fn render(root: ReactRoot, element: ReactElement) -> ();
}

// Main entry point
fn main() -{DOM}-> () {
  match DOM.querySelector("#app") {
  | Some(root) => {
      let reactRoot = DOM.createRoot(root);
      DOM.render(reactRoot, <App />)
    }
  | None => {
      // Log error to console
      // Note: This would need proper error handling in AffineScript
    }
  }
}

// Type for React elements (would be defined in React library)
struct ReactElement {
  // Opaque type for React elements
}
