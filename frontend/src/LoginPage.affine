               placeholder="you@example.com"
               autoComplete="email"
               ariaLabel="Email address"
               ariaRequired=true
               disabled=auth.authLoading
               style=inputStyle
             />
           </div>
   
           <div style={Sx.make(~marginBottom="1.5rem", ())}>
             <label htmlFor="login-password" style=labelStyle>
