#
# stapeln.launcher.a2ml — per-app launcher config for Stapeln.
# Compliant with launcher-standard.a2ml v0.3.0
#
# This is the repo-root copy. The canonical test-fixture duplicate lives at
# launch-scaffolder/examples/stapeln.launcher.a2ml and is used by unit tests;
# keep the two in sync until the fixture can be relocated.

[project]
name         = "stapeln"
display      = "Stapeln"
description  = "Visual Container Stack Designer — containers for people who hate containers"
categories   = ["Development", "System", "Utility"]
version      = "0.1.0"
license      = "PMPL-1.0-or-later"

[repo]
# NOTE: repo-dir is resolved at runtime from the launcher script location.
# Do NOT hardcode absolute paths. Leave empty or use relative paths.
path = ""

[runtime]
kind = "server-url"
port = 4010
url  = "http://localhost:4010"
startup-command-search = [
    "{repo-dir}/scripts/run.sh",
    "{repo-dir}/dev.sh",
]
# Per launcher-standard.a2ml [runtime] section:
# PID files MUST use XDG_RUNTIME_DIR or TMPDIR, NEVER /tmp directly
# Log files MUST use XDG_STATE_HOME, NEVER /tmp directly
pid-file = "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/stapeln-server.pid"
log-file = "${XDG_STATE_HOME:-$HOME/.local/state}/stapeln/server.log"
wait-for-url-timeout-seconds = 15

[version-output]
# Per launcher-standard.a2ml [version-output] section
first-line-format = "stapeln {version} ({build-sha-short}) [{platform}]"
example = "stapeln 0.1.0 (abc1234) [linux-x86_64]"
exit-code = 0

[icon]
source = "{repo-dir}/assets/icon-256.png"
