module stapeln

// Formal model generated by alloyiser from project 'stapeln'.
// Verify with: java -jar alloy.jar stapeln.als
assert no_orphan_records {
    all r: Record | some r.owner
}
check no_orphan_records for 5

assert container_integrity {
    all c: Container | some c.manifest and some c.digest
}
check container_integrity for 5

assert layer_acyclic {
    all l: Layer | l not in l.^parent
}
check layer_acyclic for 6

// Visualise a sample instance
run {} for 5
